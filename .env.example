# Copy only settings you need. Never commit real keys.
GEMINI_API_KEY=
# Independent of a general-purpose GEMINI_MODEL setting.
GEMINI_IMAGE_MODEL=gemini-3-pro-image

# Required for generation mode. Set a project you are authorized to use.
ANIGC_REFERENCE_PROJECT_ID=

# OpenAI Images API. Explicit backend gpt; no cross-provider key fallback.
GPT_API_KEY=
# Set a supported image model your API project can access.
GPT_IMAGE_MODEL=
